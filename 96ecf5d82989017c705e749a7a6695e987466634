Save and run the following validation driver. It patches temporary copies only:

```python
from pathlib import Path
import copy
import hashlib
import importlib.util
import json
import stat
import struct
import subprocess
import sys
import tempfile

script = Path('chatgpt/enable-computer-remote.py').resolve()
spec = importlib.util.spec_from_file_location('remote_patch', script)
module = importlib.util.module_from_spec(spec)
sys.dont_write_bytecode = True
spec.loader.exec_module(module)
inputs = [
    Path('/usr/lib/chatgpt/resources/app.asar'),
    Path('/tmp/chatgpt-26.924/extracted/usr/lib/chatgpt/resources/app.asar'),
]

def clone(source, target):
    subprocess.run(['cp', '--reflink=auto', '--preserve=mode', str(source), str(target)], check=True)

def read(archive, asset):
    with archive.open('rb') as f:
        prefix = f.read(16)
        sizes = struct.unpack('<4I', prefix)
        header = json.loads(f.read(sizes[3]))
        entry = header
        for component in asset.split('/'):
            entry = entry['files'][component]
        offset = 8 + sizes[1] + int(entry['offset'])
        f.seek(offset)
        return prefix, header, entry, offset, f.read(entry['size'])

with tempfile.TemporaryDirectory(prefix='computer-remote-validation-', dir='/tmp') as temporary:
    folder = Path(temporary)
    archive = folder / 'app.asar'
    for original in inputs:
        source_hash = module.sha256(original)
        selected = module.PATCHES[source_hash]
        clone(original, archive)
        result = subprocess.run([sys.executable, str(script), str(archive)], capture_output=True, text=True)
        assert result.returncode == 0, result.stderr
        print(result.stdout.strip())
        assert module.sha256(archive) == selected['sha256']
        assert archive.stat().st_size == original.stat().st_size
        assert stat.S_IMODE(archive.stat().st_mode) == stat.S_IMODE(original.stat().st_mode)
        old_prefix, old_header, old_entry, old_offset, old_asset = read(original, selected['asset'])
        new_prefix, new_header, new_entry, new_offset, new_asset = read(archive, selected['asset'])
        assert old_prefix == new_prefix and old_offset == new_offset
        assert len(old_asset) == len(new_asset)
        changes = [(i, a, b) for i, (a, b) in enumerate(zip(old_asset, new_asset)) if a != b]
        assert len(changes) == 1 and changes[0][2] == ord('0')
        assert new_asset == old_asset.replace(selected['original'], selected['patched'])
        integrity = new_entry['integrity']
        assert integrity['hash'] == hashlib.sha256(new_asset).hexdigest()
        block_size = integrity['blockSize']
        assert integrity['blocks'] == [hashlib.sha256(new_asset[i:i+block_size]).hexdigest() for i in range(0, len(new_asset), block_size)]
        new_entry['integrity'] = copy.deepcopy(old_entry['integrity'])
        assert new_header == old_header
        with original.open('rb') as before, archive.open('rb') as after:
            position = 0
            header_end = 16 + struct.unpack('<4I', old_prefix)[3]
            while left := before.read(1024*1024):
                right = after.read(len(left))
                if left != right:
                    for index, (a, b) in enumerate(zip(left, right)):
                        absolute = position + index
                        assert a == b or 16 <= absolute < header_end or old_offset <= absolute < old_offset + len(old_asset)
                position += len(left)
            assert not after.read(1)
        javascript = folder / 'connections.mjs'
        javascript.write_bytes(new_asset)
        subprocess.run(['node', '--check', str(javascript)], check=True)
        print(f"PASS {selected['version']}: exact output, only one payload byte plus target integrity changed, JS syntax and file mode verified")
        for case in ['repeat invocation', 'tampered input']:
            if case == 'tampered input':
                clone(original, archive)
                with archive.open('r+b') as f:
                    f.seek(-1, 2)
                    value = f.read(1)
                    f.seek(-1, 2)
                    f.write(bytes([value[0] ^ 1]))
            before = module.sha256(archive)
            result = subprocess.run([sys.executable, str(script), str(archive)], capture_output=True, text=True)
            assert result.returncode == 1 and 'unrecognized app.asar SHA256' in result.stderr
            assert module.sha256(archive) == before
            print(f"PASS {selected['version']}: {case} rejected without writes")
        clone(original, archive)
        expected_output = selected['sha256']
        selected['sha256'] = '0' * 64
        try:
            try:
                module.patch(archive)
            except ValueError as error:
                assert 'differs from reviewed output' in str(error)
            else:
                raise AssertionError('accepted unexpected output')
        finally:
            selected['sha256'] = expected_output
        assert module.sha256(archive) == source_hash
        assert not list(folder.glob('.computer-remote-*'))
        print(f"PASS {selected['version']}: output verification failure preserved original and cleaned temporary copy")
