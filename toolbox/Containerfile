# Dev tooling image. This is the tooling that used to be layered directly on the
# Silverblue host image, moved into a toolbox container so the host image can
# shrink toward stock Silverblue. Used via toolbox(1) or distrobox. Built in CI
# alongside the host image (.github/workflows/image.yml); see README.md here.

FROM registry.fedoraproject.org/fedora-toolbox:45

LABEL com.github.containers.toolbox="true" \
      name="workstation-toolbox" \
      version="45" \
      usage="This image is meant to be used with the toolbox(1) command" \
      summary="Fedora 45 toolbox image with workstation dev tooling" \
      maintainer="Sam Day <me@samcday.com>"

# Packages come from base/packages.list, one per line, '#' comments allowed.
COPY base/packages.list /tmp/packages.list

# Cache mounts are writable by default. Explicit rw breaks older Buildah.
RUN --mount=type=cache,id=toolbox-dnfcache,destination=/var/cache/libdnf5 \
    set -eu; \
    packages="$(sed -e 's/#.*//' -e '/^[[:space:]]*$/d' /tmp/packages.list)"; \
    if [ -z "$packages" ]; then \
        echo "ERROR: no packages found in /tmp/packages.list" >&2; \
        exit 1; \
    fi; \
    dnf install -y dnf5-plugins $packages; \
    rm -f /tmp/packages.list

# Tools shipped only as GitHub releases (oras, cfssl, k9s, sops).
RUN --mount=type=cache,id=toolbox-dnfcache,destination=/var/cache/libdnf5 \
    --mount=type=bind,source=base/install-binaries.sh,target=/tmp/install-binaries.sh \
    sh /tmp/install-binaries.sh
