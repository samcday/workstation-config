# Silverblue host image. Only what must live in the booted OS belongs here:
# kernel modules and the initrd, boot and login-time services, GNOME Shell
# extensions, device permissions, and desktop apps with no Flatpak. Dev
# tooling lives in the toolbox images (../toolbox), which update without a
# reboot. Keep this image small enough to build on a stock GitHub runner.

FROM --platform=linux/amd64 quay.io/fedora/fedora-silverblue:45

# Build-only DNF settings: retain RPMs in the cache mounts, not image layers.
# Leave the cache intact for later builds; do not change the installed DNF config.
ARG DNF_BUILD_OPTS="--setopt=keepcache=True --setopt=max_parallel_downloads=10 --setopt=max_downloads_per_mirror=10"

# Fetch the repository RPMs from RPM Fusion's origin. The redirector selected
# an unreachable mirror in GHA; package repositories still use their mirrorlists.
RUN --mount=type=cache,id=dnfcache,destination=/var/cache/libdnf5 \
    dnf $DNF_BUILD_OPTS -y install \
    https://download1.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm \
    https://download1.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm

COPY RPM-GPG-KEY-chatgpt-3BFA0E4AE8B8CC16A2D9BA684A3B4A566C4660E4.asc /etc/pki/rpm-gpg/
COPY *.repo /etc/yum.repos.d/

RUN dnf copr enable -y rowanfr/fw-ectool

# <NVIDIA-BULLSHIT>
# Refresh once after configuring the repositories. Later transactions reuse the
# shared metadata cache, subject to DNF's normal expiry rules.
RUN --mount=type=cache,id=dnfcache,destination=/var/cache/libdnf5 \
    dnf $DNF_BUILD_OPTS install --refresh -y \
      akmods \
      kernel-devel-$(rpm -q --queryformat '%{VERSION}-%{RELEASE}' kernel) \
      kernel-headers

# we isolate this step and run it without scripts because the %post
# is broken:
# `ERROR: Not to be used as root; start as user or 'akmodsbuild' instead.`
RUN --mount=type=cache,id=dnfcache,destination=/var/cache/libdnf5 \
    dnf $DNF_BUILD_OPTS install -y --setopt=tsflags=noscripts \
      akmod-nvidia

# Carry an upstream candidate for NVIDIA display failures (issue #3):
# PR #1286 bounds DIFR prefetch waits and resets faulted channels (#1289).
# 615.78.08 includes HPD-low DisplayPort detach handling, superseding PR #1359.
# The DIFR patch alone does not establish that all display-wake hangs are fixed.
# rpmfusion's kmodsrc ships the nvidia-modeset OS-agnostic
# layer as a precompiled blob (nv-modeset-kernel.o_binary) so the patch can't
# go through the akmod. Instead: fetch the upstream tree at the matching tag,
# apply the patches, rebuild just that blob and splice it into the kmodsrc tarball
# before akmods runs. Version comes from the installed kmodsrc so it can't
# mismatch. When a patch stops applying (merged, or code drifted) this fails
# loudly. Drop the corresponding patch once its fix is upstream.
COPY nvidia/*.patch /tmp/nvidia-patches/
RUN --mount=type=cache,id=dnfcache,destination=/var/cache/libdnf5 \
    set -eu && \
    V=$(rpm -q --queryformat '%{VERSION}' xorg-x11-drv-nvidia-kmodsrc) && \
    dnf $DNF_BUILD_OPTS install -y gcc-c++ patch && \
    cd /tmp && \
    curl -sfL https://github.com/NVIDIA/open-gpu-kernel-modules/archive/refs/tags/$V.tar.gz | tar xz && \
    cd open-gpu-kernel-modules-$V && \
    for P in /tmp/nvidia-patches/*.patch; do patch --batch --forward --fuzz=0 -p1 < "$P" || exit 1; done && \
    make -C src/nvidia-modeset -j$(nproc) && \
    T=/usr/share/nvidia-kmod-$V/nvidia-kmod-$V-x86_64.tar.xz && \
    mkdir /tmp/kmodsrc && tar xJf $T -C /tmp/kmodsrc && \
    install -m 0644 src/nvidia-modeset/_out/Linux_x86_64/nv-modeset-kernel.o \
      /tmp/kmodsrc/kernel-open/nvidia-modeset/nv-modeset-kernel.o_binary && \
    tar cJf $T -C /tmp/kmodsrc . && \
    cd /tmp && rm -rf /tmp/kmodsrc /tmp/open-gpu-kernel-modules-$V /tmp/nvidia-patches && \
    dnf $DNF_BUILD_OPTS remove -y gcc-c++

# thanks to pbrezina for this workaround:
# https://github.com/bootc-dev/bootc/discussions/993
RUN akmods --force --kernels `rpm -q --queryformat '%{VERSION}-%{RELEASE}.%{ARCH}' kernel-devel`

RUN --mount=type=cache,id=dnfcache,destination=/var/cache/libdnf5 \
    dnf $DNF_BUILD_OPTS install -y  \
      xorg-x11-drv-nvidia \
      xorg-x11-drv-nvidia-cuda \
      xorg-x11-drv-nvidia-power \
      libva-nvidia-driver \
      nvidia-settings \
      nvidia-persistenced
# </NVIDIA-BULLSHIT>

# Everything a toolbox cannot provide: boot/login services, device access,
# Shell extensions, and desktop apps without a Flatpak. Dev tooling is in
# ../toolbox; GUI apps with Flatpaks are installed per machine (see README).
RUN --mount=type=cache,id=dnfcache,destination=/var/cache/libdnf5 \
    dnf $DNF_BUILD_OPTS install -y \
    android-tools \
    bootc \
    chatgpt \
    claude-desktop-unofficial \
    ddcutil \
    dejavu-sans-mono-fonts \
    dkms \
    fastfetch \
    fuse-sshfs \
    fw-ectool \
    git-credential-libsecret \
    gnome-console \
    gnome-shell-extension-appindicator \
    gnome-shell-extension-caffeine \
    gnome-tweaks \
    greetd \
    greetd-fakegreet \
    gtkgreet \
    heimdall \
    htop \
    kde-connect \
    libavcodec-freeworld \
    nbd \
    phrog \
    seatd \
    syncthing \
    tailscale \
    tio \
    tmux \
    usbip \
    vim-enhanced \
    virt-install \
    virt-manager \
    wireshark \
    wl-clipboard \
    zsh

# Fedora 43+ ships Noto Color Emoji as COLRv1, which GPUI apps (Delta, Zed) can't
# paint: emoji come out as blank space (zed-industries/zed#42255). Swap in the
# last upstream CBDT bitmap build, which they render fine. The monochrome Noto
# Emoji goes too: GPUI's font matcher ignores fontconfig priority and picks it
# over the color font when both are installed (zed-industries/zed#51171).
# default-fonts-core-emoji is a metainfo-only metapackage that gets dragged out
# with them. The guard fails loudly if the rpm stops shipping COLRv1, which is
# the cue to drop this block and return to the packaged font.
RUN set -eu && \
    test -f /usr/share/fonts/google-noto-color-emoji-fonts/Noto-COLRv1.ttf && \
    dnf remove -y google-noto-color-emoji-fonts google-noto-emoji-fonts && \
    workdir=$(mktemp -d) && \
    curl -fsSL --retry 3 -o "$workdir/NotoColorEmoji.ttf" \
      https://raw.githubusercontent.com/googlefonts/noto-emoji/v2.051/fonts/NotoColorEmoji.ttf && \
    echo "72a635cb3d2f3524c51620cdde406b217204e8a6a06c6a096ff8ed4b5fd6e27b  $workdir/NotoColorEmoji.ttf" | sha256sum -c - && \
    install -D -m 0644 "$workdir/NotoColorEmoji.ttf" /usr/share/fonts/noto-color-emoji-cbdt/NotoColorEmoji.ttf && \
    rm -rf "$workdir" && \
    fc-cache -s && \
    test "$(fc-match -f '%{file}' emoji)" = /usr/share/fonts/noto-color-emoji-cbdt/NotoColorEmoji.ttf

# Discord Rich Presence for MPRIS players. The upstream binary needs openssl3-libs,
# not Fedora 45's default OpenSSL 4.
RUN --mount=type=cache,id=dnfcache,destination=/var/cache/libdnf5 \
    dnf $DNF_BUILD_OPTS install -y openssl3-libs
RUN set -eu; \
    version=1.9.1; \
    workdir=$(mktemp -d); \
    curl -fsSL --retry 3 -o "$workdir/mprisence.tar.gz" \
      "https://github.com/lazykern/mprisence/releases/download/v${version}/mprisence-v${version}-x86_64-unknown-linux-gnu.tar.gz"; \
    echo "5c42efd84275d0114a9d49a070d6dd0f44242d38daa25c64ee3de54de072c000  $workdir/mprisence.tar.gz" | sha256sum -c -; \
    tar -xzf "$workdir/mprisence.tar.gz" -C "$workdir" mprisence; \
    install -m 0755 "$workdir/mprisence" /usr/bin/mprisence; \
    /usr/bin/mprisence --version; \
    rm -rf "$workdir"

COPY mprisence.service /usr/lib/systemd/user/mprisence.service
RUN systemctl --global enable mprisence.service

RUN akmods --force --kernels `rpm -q --queryformat '%{VERSION}-%{RELEASE}.%{ARCH}' kernel-devel`

# ChatGPT hardcodes X11 ozone, where its stray override-redirect avatarOverlay window renders the app click-through. Force Wayland.
RUN grep -q '^Exec=chatgpt %U' /usr/share/applications/chatgpt.desktop && \
    sed -i 's|^Exec=chatgpt %U|Exec=chatgpt --ozone-platform=wayland %U|' /usr/share/applications/chatgpt.desktop

# Claude Desktop defaults to XWayland on GNOME. On mutter 51, hiding the window to tray and reopening it
# leaves the remapped Xwayland surface without pointer focus (clicks fall through to the window behind).
# CLAUDE_USE_WAYLAND=1 is the launcher's supported switch for native Wayland.
RUN grep -q '^Exec=/usr/bin/claude-desktop-unofficial %u' /usr/share/applications/claude-desktop-unofficial.desktop && \
    sed -i 's|^Exec=/usr/bin/claude-desktop-unofficial %u|Exec=env CLAUDE_USE_WAYLAND=1 /usr/bin/claude-desktop-unofficial %u|' /usr/share/applications/claude-desktop-unofficial.desktop

# GNOME 51: the Fedora 45 rpm of Caffeine (60) still caps shell-version at 50, so
# the shell refuses to load it ("OUT OF DATE"). Upstream supports 51 but no rebuilt
# rpm has landed. Overlay the upstream tree using the Fedora spec's install steps.
# First check that the rpm's metadata.json still lacks "51"; once Fedora ships a
# 51-capable rpm the guard fails loudly, which is the cue to delete this block.
RUN set -eu && \
    ext=/usr/share/gnome-shell/extensions/caffeine@patapon.info && \
    jq -e '.["shell-version"] | index("51") | not' $ext/metadata.json >/dev/null && \
    mkdir -p /tmp/caffeine && cd /tmp/caffeine && \
    curl -fsSL https://github.com/eonpatapon/gnome-shell-extension-caffeine/archive/be18b3558a250d672a7108f01a8dcf55c0935bc6.tar.gz | tar xz --strip-components=1 && \
    cd caffeine@patapon.info && \
    rm -rf $ext && install -d -m 0755 $ext && \
    cp -r --preserve=timestamps *.js metadata.json icons preferences $ext && \
    install -D -p -m 0644 schemas/org.gnome.shell.extensions.caffeine.gschema.xml /usr/share/glib-2.0/schemas/org.gnome.shell.extensions.caffeine.gschema.xml && \
    for po in locale/*.po; do \
      install -d -m 0755 /usr/share/${po%.po}/LC_MESSAGES && \
      msgfmt -o /usr/share/${po%.po}/LC_MESSAGES/gnome-shell-extension-caffeine.mo $po; \
    done && \
    jq -e '.["shell-version"] | index("51")' $ext/metadata.json >/dev/null && \
    cd / && rm -rf /tmp/caffeine

RUN glib-compile-schemas /usr/share/glib-2.0/schemas

COPY sysctl.conf /usr/lib/sysctl.d/60-workstation.conf

# Update initrd to include TPM2 disk unlock and include vfio-pci early (to denylist PCI devices,
# like NVIDIA GPU on my desktop)
COPY dracut.conf /usr/lib/dracut/dracut.conf.d/10-sam.conf
RUN export DRACUT_NO_XATTR=1 && \
    export KERNEL_VERSION="$(rpm -qa kernel --queryformat '%{VERSION}-%{RELEASE}.%{ARCH}')" && \
    stock_arguments=$(lsinitrd "/lib/modules/${KERNEL_VERSION}/initramfs.img"  | grep '^Arguments: ' | sed 's/^Arguments: //') && \
    mkdir -p /tmp/dracut /var/roothome && \
    bash <(/usr/bin/echo "dracut -f /lib/modules/${KERNEL_VERSION}/initramfs.img $stock_arguments") && \
    rm -rf /var/* /tmp/*  && \
    ostree container commit
