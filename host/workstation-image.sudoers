# Commands used by ./build-image and the land skill; OS upgrades and reboots stay manual.
sam ALL=(root) NOPASSWD: /usr/bin/podman --storage-opt overlay.mountopt\=nodev build -t workstation-image\:latest .
sam ALL=(root) NOPASSWD: /usr/bin/podman image inspect --format {{.Digest}} workstation-image\:latest
